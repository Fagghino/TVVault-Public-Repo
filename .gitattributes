# Set default behavior to automatically normalize line endings.
* text=auto

# Force LF line endings for Kotlin, Java, XML, Gradle, Markdown, JSON, Properties, CSV
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Denote binary files (no normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.zip binary
*.tar binary
*.gz binary
*.mp4 binary
*.mov binary
